	<script>
(function () {

    /* =========================================================
       SUPABASE SETTINGS
       ========================================================= */

    var SUPABASE_URL =
        "https://fkkdkjrlatziipfdqbye.supabase.co";

    var SUPABASE_KEY =
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZra2RranJsYXR6aWlwZmRxYnllIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg0NjIyOTcsImV4cCI6MjEwNDAzODI5N30.gfppFfuVV3j59kJmYukGrn-WVYfRBBKBERyXBQ1opNk";

    var SUPABASE_SAVES =
        SUPABASE_URL + "/rest/v1/saves";


    /* =========================================================
       USERNAME
       ========================================================= */

    function getUsername() {

        var username =
            localStorage.getItem("cookieCloudUsername");

        if (!username) {

            username = prompt(
                "Enter your cloud-save username:"
            );

            if (!username) {
                alert("Username is required.");
                return null;
            }

            username = username.trim();

            if (!username) {
                alert("Username cannot be empty.");
                return null;
            }

            username =
                username.replace(
                    /[\/\\:*?"<>|]/g,
                    "_"
                );

            localStorage.setItem(
                "cookieCloudUsername",
                username
            );
        }

        return username;
    }


    /* =========================================================
       CHANGE USERNAME
       ========================================================= */

    window.changeCloudUsername = function () {

        var current =
            localStorage.getItem(
                "cookieCloudUsername"
            ) || "";

        var username = prompt(
            "Enter your cloud-save username:",
            current
        );

        if (!username) return;

        username = username.trim();

        if (!username) {
            alert("Username cannot be empty.");
            return;
        }

        username =
            username.replace(
                /[\/\\:*?"<>|]/g,
                "_"
            );

        localStorage.setItem(
            "cookieCloudUsername",
            username
        );

        alert(
            "Username changed to: " +
            username
        );
    };


    /* =========================================================
       UPLOAD SAVE
       ========================================================= */

    window.uploadCloudSave = async function () {

        var username = getUsername();

        if (!username) return;


        /* Bakery name */

        var bakeryName =
            Game.bakeryName ||
            "Unnamed Bakery";

        bakeryName =
            bakeryName.trim();

        if (!bakeryName) {
            bakeryName =
                "Unnamed Bakery";
        }

        bakeryName =
            bakeryName.replace(
                /[\/\\:*?"<>|]/g,
                "_"
            );


        /* Get Cookie Clicker save */

        var saveData;

        try {

            saveData =
                Game.WriteSave(1);

        }
        catch (e) {

            alert(
                "Could not create the Cookie Clicker save.\n\n" +
                e
            );

            return;
        }


        if (!saveData) {

            alert(
                "Cookie Clicker returned an empty save."
            );

            return;
        }


        /* =====================================================
           DATE / TIME
           ===================================================== */

        var now = new Date();

        var date =
            (now.getMonth() + 1) +
            "/" +
            now.getDate() +
            "/" +
            now.getFullYear();

        var hours =
            now.getHours();

        var minutes =
            now.getMinutes();

        var ampm =
            hours >= 12
                ? "PM"
                : "AM";

        hours =
            hours % 12;

        if (hours === 0) {
            hours = 12;
        }

        minutes =
            minutes
                .toString()
                .padStart(2, "0");

        var time =
            hours +
            ":" +
            minutes +
            " " +
            ampm;


        /* =====================================================
           FILENAME
           ===================================================== */

        var filename =
            bakeryName +
            " | " +
            username +
            " | " +
            date +
            " " +
            time +
            ".txt";


        /* =====================================================
           UPLOAD TO SUPABASE
           ===================================================== */

        try {

            


            var response =
                await fetch(
                    SUPABASE_SAVES,
                    {
                        method: "POST",

                        headers: {
                            "apikey":
                                SUPABASE_KEY,

                            "Authorization":
                                "Bearer " +
                                SUPABASE_KEY,

                            "Content-Type":
                                "application/json",

                            "Prefer":
                                "return=minimal"
                        },

                        body:
                            JSON.stringify({
                                username:
                                    username,

                                filename:
                                    filename,

                                save_data:
                                    saveData
                            })
                    }
                );


            if (!response.ok) {

                var errorText =
                    await response.text();

                throw new Error(
                    errorText ||
                    "Supabase upload failed."
                );
            }


            alert(
                "Save uploaded successfully!\n\n" +
                filename
            );

        }
        catch (e) {

            console.error(e);

            alert(
                "Cloud save upload failed.\n\n" +
                e.message
            );
        }
    };


    /* =========================================================
       IMPORT SAVE
       ========================================================= */

    window.importCloudSave = async function () {

        var username =
            getUsername();

        if (!username) return;


        try {

           


            /* =================================================
               GET SAVES FOR THIS USER

               Sorted newest -> oldest
               ================================================= */

            var url =
                SUPABASE_SAVES +
                "?select=id,filename,save_data,created_at" +
                "&username=eq." +
                encodeURIComponent(username) +
                "&order=created_at.desc";


            var response =
                await fetch(
                    url,
                    {
                        method: "GET",

                        headers: {
                            "apikey":
                                SUPABASE_KEY,

                            "Authorization":
                                "Bearer " +
                                SUPABASE_KEY
                        }
                    }
                );


            if (!response.ok) {

                var errorText =
                    await response.text();

                throw new Error(
                    errorText ||
                    "Could not get saves."
                );
            }


            var saves =
                await response.json();


            /* =================================================
               NO SAVES
               ================================================= */

            if (
                !saves ||
                saves.length === 0
            ) {

                alert(
                    "No cloud saves were found for " +
                    username +
                    "."
                );

                return;
            }


            /* =================================================
               BUILD SAVE LIST

               Supabase already returns these
               newest -> oldest.
               ================================================= */

            var message =
                "Choose a save to import:\n\n";


            for (
                var i = 0;
                i < saves.length;
                i++
            ) {

                message +=
                    (i + 1) +
                    ". " +
                    saves[i].filename +
                    "\n";
            }


            var choice =
                prompt(message);


            if (choice === null) {
                return;
            }


            var number =
                parseInt(choice, 10);


            if (
                isNaN(number) ||
                number < 1 ||
                number > saves.length
            ) {

                alert(
                    "Invalid save number."
                );

                return;
            }


            var selected =
                saves[number - 1];


            /* =================================================
               CHECK SAVE DATA
               ================================================= */

            if (!selected.save_data) {

                alert(
                    "The cloud save was empty."
                );

                return;
            }


            /* =================================================
               LOAD COOKIE CLICKER SAVE
               ================================================= */

            if (
                typeof Game.LoadSave ===
                "function"
            ) {

                Game.LoadSave(
                    selected.save_data
                );

            }
            else {

                /*
                 * Fallback for versions where
                 * LoadSave isn't available.
                 */

                Game.ImportSave();

                setTimeout(
                    function () {

                        var input =
                            document.querySelector(
                                "#textareaPrompt"
                            );

                        if (input) {

                            input.value =
                                selected.save_data;
                        }

                    },
                    100
                );
            }


            alert(
                "Save imported successfully!\n\n" +
                selected.filename
            );

        }
        catch (e) {

            console.error(e);

            alert(
                "Cloud save import failed.\n\n" +
                e.message
            );
        }
    };


    /* =========================================================
       CLOUD BUTTONS
       ========================================================= */

    function addCloudButtons() {

    var menu = document.getElementById("menu");

    if (!menu) return;


    var subsections =
        menu.getElementsByClassName("subsection");


    for (var i = 0; i < subsections.length; i++) {

        var subsection = subsections[i];

        var title =
            subsection.getElementsByClassName("title")[0];


        if (
            !title ||
            title.textContent.trim() !== "General"
        ) {
            continue;
        }


        /*
         * Already added?
         */
        if (
            subsection.querySelector(
                "#cloudSaveListing"
            )
        ) {
            return;
        }


        /*
         * Create cloud save section
         */
        var listing =
            document.createElement("div");

        listing.className = "listing";
        listing.id = "cloudSaveListing";


        listing.innerHTML =

            '<a class="option" ' +
            'onclick="uploadCloudSave();">' +
            'Upload Save' +
            '</a>' +

            '<a class="option" ' +
            'onclick="importCloudSave();">' +
            'Import Save' +
            '</a>' +

            '<a class="option" ' +
            'onclick="changeCloudUsername();">' +
            'Change Username' +
            '</a>' +

            '<label>' +
            'A feature added by ANDREpicasso to save and load your Cookie Clicker save from the cloud' +
            '</label>';


        /*
         * Find "Wipe save" INSIDE General
         */
        var listings =
            subsection.getElementsByClassName(
                "listing"
            );


        var inserted = false;


        for (
            var j = 0;
            j < listings.length;
            j++
        ) {

            if (
                listings[j]
                    .textContent
                    .indexOf("Wipe save") !== -1
            ) {

                subsection.insertBefore(
                    listing,
                    listings[j]
                );

                inserted = true;
                break;
            }
        }


        /*
         * If Wipe save wasn't found,
         * put it at the end of General.
         */
        if (!inserted) {

            subsection.appendChild(
                listing
            );
        }


        return;
    }
}


    /* =========================================================
       WATCH COOKIE CLICKER'S MENU
       ========================================================= */

    function startObserver() {

        var menu =
            document.getElementById(
                "menu"
            );


        if (!menu) {

            setTimeout(
                startObserver,
                100
            );

            return;
        }


        addCloudButtons();


        var observer =
            new MutationObserver(
                function () {

                    addCloudButtons();

                }
            );


        observer.observe(
            menu,
            {
                childList: true,
                subtree: true
            }
        );
    }


    startObserver();

})();
</script>
